PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/campus_maintenance
# Set USE_IN_MEMORY_DB=true for quick local demo if mongod is not installed
USE_IN_MEMORY_DB=false

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=cmc_session
CORS_ORIGIN=http://localhost:5173

# Storage: local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MEDIA_SIGNING_SECRET=replace-with-a-long-random-media-signing-secret

# S3-compatible storage (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# AI: live | mock
AI_MODE=live
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_MS=25000
AI_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_MAX=25
