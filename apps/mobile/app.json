{
  "expo": {
    "name": "Campus Maintenance Copilot",
    "slug": "campus-maintenance-copilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "campuscopilot",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "android": {
      "package": "edu.campus.maintenancecopilot",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Campus Maintenance Copilot to capture issue and repair photos."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Campus Maintenance Copilot to record maintenance voice notes."
        }
      ],
      "expo-secure-store",
      "expo-sqlite"
    ],
    "extra": {
      "apiUrl": "https://campus-maintenance-media.onrender.com",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b4259d9f-14fa-4a79-a5e9-dfb2121bc5e1"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/b4259d9f-14fa-4a79-a5e9-dfb2121bc5e1",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "owner": "mohdtalha506",
    "ios": {}
  }
}
